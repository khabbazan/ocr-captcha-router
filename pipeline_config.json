{
  "pipeline_type": "ocr-captcha-router",
  "router_path": ".",
  "math_model_id": "arkhabbazan/ocr-math-captcha",
  "digit_model_id": "arkhabbazan/ocr-digits-captcha",
  "router_confidence_threshold": 0.95,
  "math_confidence_threshold": 0.85,
  "full_math_pattern": "^\\d+[+-]\\d+=\\?$",
  "partial_math_pattern": "^\\d+[+-]\\d+=?$",
  "digit_pattern": "^\\d{4,7}$",
  "fallback": "run-both-and-score-format",
  "reject_invalid_partial_math": true,
  "source_repositories": {
    "router": "arkhabbazan/ocr-captcha-router",
    "math": "arkhabbazan/ocr-math-captcha",
    "digits": "arkhabbazan/ocr-digits-captcha"
  }
}
